# ===================================================
# KrishiMitra AI Backend Environment Configuration Example
# ===================================================

# Core Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://krishimitra-ai.vercel.app

# Database & Authentication
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/krishimitra?retryWrites=true&w=majority
JWT_SECRET=your_jwt_signing_secret_min_32_characters

# AI & Weather Intelligence API Providers
GEMINI_API_KEY=your_google_gemini_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# Media Storage Provider (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Geospatial Provider
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Cloud Messaging (FCM) Push Notifications (Service Account credentials kept exclusively on backend)
# Render Secret File Configuration (Recommended on Render):
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/serviceAccountKey.json
#
# Alternative local & cloud configurations:
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/firebase-service-account.json
# FIREBASE_PROJECT_ID=the-khedut-809ac
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@the-khedut-809ac.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

