# The Khedut - Android Production Release Keystore Configuration
# -----------------------------------------------------------------
# INSTRUCTIONS FOR FOUNDER:
# 1. Copy this file to 'keystore.properties' in frontend/android/
# 2. Ensure your existing keystore is located at:
#    C:/AndroidSigning/thekhedut-release-key.jks
# 3. Fill in your valid keystore and key passwords below.
# 4. NEVER commit 'keystore.properties' or '*.jks' to git repository!
# -----------------------------------------------------------------

storeFile=C:/AndroidSigning/thekhedut-release-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=thekhedut
keyPassword=YOUR_KEY_PASSWORD
