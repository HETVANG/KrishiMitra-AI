# The Khedut - Android Release Keystore Configuration Template
# -----------------------------------------------------------------
# INSTRUCTIONS FOR FOUNDER:
# 1. Copy this file to 'keystore.properties' in frontend/android/
# 2. Generate a production keystore (or use your existing upload key):
#    keytool -genkeypair -v -storetype PKCS12 -keystore thekhedut-release.keystore -alias thekhedut-upload -keyalg RSA -keysize 2048 -validity 10000
# 3. Fill in the values below with your keystore path and passwords.
# 4. NEVER commit 'keystore.properties' or '*.keystore' to git repository!
# -----------------------------------------------------------------

storeFile=thekhedut-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=thekhedut-upload
keyPassword=YOUR_KEY_PASSWORD
